{
  "name": "motto",
  "version": "0.9.0",
  "description": "Virtual purchase intermediary for AI agents: coordinate a supported provider, verify delivery, and settle an x402 upto payment on Solana.",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "node src/server.js",
    "bench": "node bench/generate.js && node bench/run.js",
    "buyer": "node buyer/buy.js",
    "tunnel": "cloudflared tunnel --url http://127.0.0.1:8787",
    "devnet:status": "node scripts/devnet-status.mjs",
    "devnet:fund": "node scripts/devnet-status.mjs --airdrop",
    "start:sandbox": "NETWORK=localnet node src/server.js",
    "buy:devnet": "node scripts/devnet-buy.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@solana/kit": "^6.10.0",
    "@solana/pay-kit": "^0.12.0",
    "bs58": "^6.0.0",
    "express": "^5.2.1"
  }
}
