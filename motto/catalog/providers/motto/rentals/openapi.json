{
  "openapi": "3.1.0",
  "info": {
    "title": "Motto Research",
    "version": "0.9.0",
    "description": "Digital research quotes within caller-selected spending permission. This draft documents a two-step quote and paid purchase flow; registry compatibility and the historical service URL are unverified."
  },
  "components": {
    "securitySchemes": {
      "workspace": {
        "type": "http",
        "scheme": "bearer",
        "description": "Required when the operator configures MOTTO_API_KEY. Remote and mainnet workspaces require authentication."
      }
    }
  },
  "paths": {
    "/v1/services": {
      "get": {
        "summary": "Read research pricing and acceptance rules",
        "responses": {
          "200": {
            "description": "Network, service prices and rules, and public receipt signing key."
          }
        }
      }
    },
    "/v1/quotes": {
      "post": {
        "summary": "Quote research within caller permission",
        "security": [
          {
            "workspace": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "service",
                  "input",
                  "max_spend_usd"
                ],
                "properties": {
                  "service": {
                    "const": "research"
                  },
                  "input": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "query",
                      "count"
                    ],
                    "properties": {
                      "query": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 200
                      },
                      "count": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 20
                      },
                      "required_terms": {
                        "type": "array",
                        "maxItems": 5,
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        }
                      },
                      "from_year": {
                        "type": "integer",
                        "minimum": 1000,
                        "maximum": 9999
                      },
                      "to_year": {
                        "type": "integer",
                        "minimum": 1000,
                        "maximum": 9999
                      }
                    }
                  },
                  "max_spend_usd": {
                    "type": "string",
                    "pattern": "^\\d+(?:\\.\\d{1,6})?$",
                    "description": "Caller-selected maximum for one purchase, never set from the provider price."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Immutable expiring quote with task, acceptance, user limit, and ceiling."
          },
          "400": {
            "description": "Invalid task or spending permission."
          },
          "401": {
            "description": "Workspace key required."
          },
          "422": {
            "description": "Quote would exceed caller permission."
          }
        }
      }
    },
    "/v1/quotes/{quote_id}": {
      "get": {
        "summary": "Inspect a stored quote",
        "security": [
          {
            "workspace": []
          }
        ],
        "parameters": [
          {
            "name": "quote_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stored immutable quote."
          },
          "404": {
            "description": "Quote not found."
          }
        }
      }
    },
    "/v1/purchases/{quote_id}": {
      "post": {
        "summary": "Purchase the accepted research quote",
        "security": [
          {
            "workspace": []
          }
        ],
        "description": "Authorize only the quote ceiling, bounded by caller permission. The empty body cannot change accepted task input. Complete delivery earns the quoted price; failed acceptance earns zero. Unconfirmed settlements retain unknown charge and return amounts.",
        "parameters": [
          {
            "name": "quote_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128,
              "pattern": "^[a-zA-Z0-9_-]+$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Purchase record with signed reading and reported settlement state; inspect status."
          },
          "202": {
            "description": "Previously recorded purchase is still in progress."
          },
          "400": {
            "description": "Invalid purchase request."
          },
          "401": {
            "description": "Workspace key required."
          },
          "402": {
            "description": "x402 upto USDC challenge for this immutable quote ceiling."
          },
          "409": {
            "description": "Quote, idempotency key, or payment-channel conflict."
          },
          "410": {
            "description": "Quote expired."
          },
          "500": {
            "description": "Service error; inspect purchase history before retrying."
          }
        }
      }
    },
    "/v1/purchases": {
      "get": {
        "summary": "Read private purchase history",
        "security": [
          {
            "workspace": []
          }
        ],
        "responses": {
          "200": {
            "description": "Latest recorded purchases, delivery checks and settlement state."
          }
        }
      }
    }
  }
}
