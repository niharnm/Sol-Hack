{
  "openapi": "3.1.0",
  "info": {
    "title": "Motto Research",
    "version": "1.0.0",
    "description": "Motto is a virtual purchase intermediary. This sidecar publishes one paid offer: a validated three-source research pack from Crossref public metadata. Motto does not accept physical-device requests or arbitrary actions.",
    "x-guidance": "The buyer-facing entry point is Claude through Solana Pay or the Pay CLI. Use POST /v1/buy/research only for a virtual research-source pack. A valid unpaid request returns an x402 upto offer for a ceiling of 1 USDC. The payment-aware client authorizes the hold and retries. A complete three-record pack costs 1 USDC. An incomplete result or provider failure costs 0 USDC. Send an Idempotency-Key and do not repeat a successful purchase."
  },
  "paths": {
    "/v1/buy/research": {
      "post": {
        "operationId": "buyResearch",
        "summary": "Buy a validated three-source research pack",
        "description": "Routes a virtual research request to Crossref public metadata and validates that three distinct DOI-backed records have nonempty titles. Complete delivery charges 1 USDC. An incomplete result or provider failure charges 0 USDC and releases the hold. A missing or invalid query is rejected before payment.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Client-generated key for safe retries with the same payer. Maximum 256 characters.",
            "schema": {
              "type": "string",
              "maxLength": 256
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "query": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 200,
                    "description": "Research topic for the three-record citation pack."
                  }
                },
                "required": [
                  "query"
                ]
              },
              "example": {
                "query": "refundable settlement for autonomous purchases"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Purchase completed or refunded. The response states the outcome, amount charged, amount returned, deliverable, checks, signature, and network.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "hold_id",
                    "item",
                    "status",
                    "outcome",
                    "hold_usd",
                    "charged_usd",
                    "returned_usd",
                    "reason",
                    "signed_reading",
                    "network"
                  ],
                  "properties": {
                    "hold_id": {
                      "type": "string"
                    },
                    "item": {
                      "type": "string",
                      "const": "research"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "kept",
                        "refunded",
                        "settle_failed"
                      ]
                    },
                    "outcome": {
                      "type": "string",
                      "enum": [
                        "delivered",
                        "inconclusive",
                        "check_failed"
                      ]
                    },
                    "hold_usd": {
                      "type": "string",
                      "const": "1.00"
                    },
                    "charged_usd": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "1.00 for complete delivery, 0.00 for a refund, or null when settlement failed."
                    },
                    "returned_usd": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "0.00 for complete delivery, 1.00 for a refund, or null when settlement failed."
                    },
                    "reason": {
                      "type": "string"
                    },
                    "signed_reading": {
                      "type": "object",
                      "description": "Signed research result. A failed provider check may return an unsigned failure reading.",
                      "properties": {
                        "query": {
                          "type": "string"
                        },
                        "provider": {
                          "type": "string",
                          "description": "Crossref public metadata API."
                        },
                        "checks": {
                          "type": "object",
                          "properties": {
                            "required_count": {
                              "type": "integer",
                              "const": 3
                            },
                            "received_count": {
                              "type": "integer"
                            },
                            "distinct_dois": {
                              "type": "boolean"
                            },
                            "titles_present": {
                              "type": "boolean"
                            },
                            "passed": {
                              "type": "boolean"
                            }
                          }
                        },
                        "deliverable": {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "const": "citation_pack"
                            },
                            "query": {
                              "type": "string"
                            },
                            "citations": {
                              "type": "array",
                              "maxItems": 3,
                              "items": {
                                "type": "object",
                                "required": [
                                  "title",
                                  "doi",
                                  "url"
                                ],
                                "properties": {
                                  "title": {
                                    "type": "string"
                                  },
                                  "doi": {
                                    "type": "string"
                                  },
                                  "url": {
                                    "type": "string",
                                    "format": "uri"
                                  },
                                  "publisher": {
                                    "type": [
                                      "string",
                                      "null"
                                    ]
                                  }
                                }
                              }
                            }
                          }
                        },
                        "limitations": {
                          "type": "string",
                          "description": "The checks do not establish relevance, quality, DOI resolution, or full-text access."
                        },
                        "ts": {
                          "type": "integer"
                        },
                        "signature": {
                          "type": "string",
                          "description": "Hex ed25519 signature over the reading fields."
                        },
                        "devicePublicKey": {
                          "type": "string",
                          "description": "Hex ed25519 public key used to verify the reading signature."
                        }
                      }
                    },
                    "settlement_tx": {
                      "type": "string",
                      "description": "Settlement transaction signature when available."
                    },
                    "settle_error": {
                      "type": "string",
                      "description": "Present when status is settle_failed."
                    },
                    "network": {
                      "type": "string",
                      "description": "Network reported by the running service."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid research query. Rejected before payment."
          },
          "402": {
            "description": "Payment Required. x402 upto offer for a hold of up to 1 USDC, 1000000 base units."
          },
          "500": {
            "description": "Provider or validation failure. No charge is settled."
          }
        },
        "x-payment-info": {
          "offers": [
            {
              "amount": "1000000",
              "currency": "USDC",
              "description": "up to 1 USDC",
              "intent": "charge",
              "method": "x402",
              "network": "solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1",
              "scheme": "upto"
            }
          ]
        }
      }
    }
  }
}
