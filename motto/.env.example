# Network: devnet (default), localnet (Pay.sh sandbox), or mainnet
NETWORK=devnet
# RPC_URL defaults to https://api.devnet.solana.com on devnet.
# Devnet uses isolated wallets in keys/devnet/ and logs in data/devnet/.
# Fund these wallets with test SOL and test USDC; npm run devnet:status shows addresses.
RPC_URL=
PORT=8787

# Operator signer (base58, hex or JSON array). Required on mainnet; the demo signer is refused there.
OPERATOR_KEY=
# Where settled USDC lands. Defaults to the operator signer's address.
RECIPIENT=

# Receipt memos (optional). Desk wallet that posts a memo tx per settlement.
RECEIPT_KEY=
RECEIPT_RPC_URL=
# WebSocket endpoint for receipt confirmations. Defaults to RECEIPT_RPC_URL with ws(s)://.
RECEIPT_WS_URL=

# Hold log directory (holds.jsonl). Reloaded on start so counters survive a restart.
DATA_DIR=data
# Optional bearer token for reading detailed holds and the event stream remotely.
# Loopback access remains available to the local console. Use a long random value.
MOTTO_ADMIN_TOKEN=
# Delivery signing key (ed25519 PEM), created on first run if missing.
DEVICE_KEY_PATH=keys/device.pem
