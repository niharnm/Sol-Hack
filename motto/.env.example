# Solana Devnet by default. Devnet tokens have no monetary value.
NETWORK=devnet
# Devnet RPC defaults to https://api.devnet.solana.com and is checked by genesis hash.
# NETWORK=localnet uses https://402.surfnet.dev:8899; mainnet requires an explicit RPC.
# RPC_URL=https://api.devnet.solana.com
PORT=8787
HOST=127.0.0.1
# Optional for loopback Devnet/sandbox. Required on mainnet or a remote bind.
# Use at least 32 random characters. Clients send Authorization: Bearer <value>.
MOTTO_API_KEY=
# Canonical origin for remote paid requests. Mainnet requires HTTPS.
# PUBLIC_BASE_URL=https://your-service.example

# Mainnet requires an explicit operator signer, base58, hex, or JSON array.
# Devnet creates an isolated local operator signer instead. Never commit private keys.
OPERATOR_KEY=
# Isolated Devnet operator and buyer keypairs, never shared with mainnet wallets.
DEVNET_KEYS_DIR=keys/devnet

# Price per accepted citation record. Quotes snapshot the price at creation.
RESEARCH_UNIT_USD=0.05
# Server upper bound for the requested per-purchase permission. Never raises the user's limit.
RESEARCH_MAX_SPEND_USD=1000
QUOTE_TTL_SECONDS=120
# Defaults to data/<network>, including data/devnet. Set a separate path per network.
# DATA_DIR=data/devnet
# Service receipt signing key, independent of the payment wallet.
DEVICE_KEY_PATH=keys/device.pem
