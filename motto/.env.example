# Sandbox by default. Mainnet payments require explicit operator configuration.
NETWORK=localnet
# Optional sandbox override. Required on mainnet.
# Leave unset to use https://402.surfnet.dev:8899 in the sandbox.
# RPC_URL=https://your-mainnet-rpc.example
PORT=8787
HOST=127.0.0.1
# Required on mainnet and when HOST permits remote clients.
# Use a long random value. Clients supply Authorization: Bearer <value>.
MOTTO_API_KEY=
# Canonical public origin for remote paid requests. HTTPS required on real networks.
# PUBLIC_BASE_URL=https://your-service.example

# Mainnet operator signer, base58, hex, or JSON array. Never commit a private key.
OPERATOR_KEY=

# Price per accepted citation record. Quotes snapshot the price at creation.
RESEARCH_UNIT_USD=0.05
# Server upper bound for the requested per-purchase spending permission.
# This never sets or raises the user's limit.
RESEARCH_MAX_SPEND_USD=1000
QUOTE_TTL_SECONDS=120
# SQLite quote/purchase records and local key storage.
DATA_DIR=data
DEVICE_KEY_PATH=keys/device.pem
