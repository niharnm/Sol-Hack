# Network: localnet (Pay.sh sandbox, default) or mainnet
NETWORK=localnet
# RPC_URL defaults to https://402.surfnet.dev:8899 on localnet. Set a real RPC for mainnet.
RPC_URL=
PORT=8787

# Operator signer (base58, hex or JSON array). Required on mainnet; the demo signer is refused there.
OPERATOR_KEY=
# Where settled USDC lands. Defaults to the operator signer's address.
RECIPIENT=

# Charger: how long to wait for power to arrive after a hold on battery.
CHARGER_WAIT_MS=30000
# Hotspot: default gateway IP of the venue network. On it -> already handled.
VENUE_GATEWAY=

# Receipt memos (optional). Desk wallet that posts a memo tx per settlement.
RECEIPT_KEY=
RECEIPT_RPC_URL=

# Hold log directory (holds.jsonl). Reloaded on start so counters survive a restart.
DATA_DIR=data
# Device signing key (ed25519 PEM), created on first run if missing.
DEVICE_KEY_PATH=keys/device.pem

# Testing only: force the power reading (ac | battery).
MOCK_POWER=
